{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bend DevOps Guardian Rules Schema",
  "description": "Validation schema for extensible engineering, architecture, culture, code quality, and security rule packs and standalone rules.",
  "oneOf": [
    {
      "type": "object",
      "required": ["version", "rules"],
      "properties": {
        "$schema": { "type": "string" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "manifesto_name": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "tier": { "type": "string", "enum": ["builtin", "organization", "project", "custom"] },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/definitions/rule_item" }
        }
      }
    },
    {
      "$ref": "#/definitions/rule_item"
    }
  ],
  "definitions": {
    "rule_item": {
      "type": "object",
      "required": ["id", "name", "severity"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9_-]+$",
          "description": "Canonical identifier of the rule (e.g., CULT01, ARCH-LAYER-01, SEC-006)"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 150
        },
        "description": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": ["pattern", "naming", "dependency", "architecture", "file_folder", "ast", "language_specific"]
        },
        "category": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": ["P0", "P1", "P2", "P3", "INFO", "P0_BLOCKING", "P1_WARNING", "P2_INFO"]
        },
        "penalty_points": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "status": {
          "type": "string",
          "enum": ["DRAFT", "TESTING", "VALIDATED", "ACTIVE", "DEPRECATED", "ARCHIVED", "active", "inactive"]
        },
        "enabled": {
          "type": "boolean"
        },
        "tier": {
          "type": "string",
          "enum": ["builtin", "organization", "project", "custom"]
        },
        "layer": {
          "type": "string",
          "description": "Target architectural layer of the rule"
        },
        "architectures": {
          "type": "array",
          "items": { "type": "string" }
        },
        "languages": {
          "type": "array",
          "items": { "type": "string" }
        },
        "scope": {
          "type": "object",
          "properties": {
            "include": { "type": "array", "items": { "type": "string" } },
            "exclude": { "type": "array", "items": { "type": "string" } },
            "target_layer": { "type": "string" }
          }
        },
        "condition": {
          "type": "object",
          "properties": {
            "pattern": { "type": "string" },
            "patterns": { "type": "array", "items": { "type": "string" } },
            "naming_convention": { "type": "string", "enum": ["PascalCase", "camelCase", "snake_case", "kebab-case", "UPPER_CASE"] },
            "source_layer": { "type": "string" },
            "forbidden_layer": { "type": "string" },
            "forbidden_targets": { "type": "array", "items": { "type": "string" } },
            "required_path_prefix": { "type": "string" },
            "ast_selector": { "type": "string" }
          }
        },
        "message": {
          "type": "string"
        },
        "suggestion": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "remediation": {
          "type": "string"
        },
        "detection_patterns": {
          "type": "array",
          "items": { "type": "string" }
        },
        "forbidden_targets": {
          "type": "array",
          "items": { "type": "string" }
        },
        "suppression": {
          "type": "object",
          "properties": {
            "allowed": { "type": "boolean" },
            "pragma": { "type": "string" },
            "requires_reason": { "type": "boolean" },
            "minimum_reason_length": { "type": "integer", "minimum": 1 }
          }
        },
        "metadata": {
          "type": "object",
          "properties": {
            "author": { "type": "string" },
            "created_at": { "type": "string" },
            "updated_at": { "type": "string" },
            "tags": { "type": "array", "items": { "type": "string" } }
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "input", "expected_violation"],
            "properties": {
              "name": { "type": "string" },
              "input": { "type": "string" },
              "expected_violation": { "type": "boolean" },
              "expected_line": { "type": "integer" }
            }
          }
        }
      }
    }
  }
}
